# GitHub OAuth App Client ID（可选；配置后可用设备码登录）
# 创建：https://github.com/settings/applications/new
# Device Flow 不需要把 Client Secret 放进前端
VITE_GITHUB_CLIENT_ID=

# 生产环境 OAuth 代理根地址（需代理 /login/device/code 与 /login/oauth/access_token）
# 本地开发默认走 Vite 的 /gh-oauth 代理，可不填
# 也可用：node scripts/oauth-proxy.mjs → http://127.0.0.1:8787
VITE_GITHUB_OAUTH_PROXY=

# 可选：本机 token-agent 地址（线上 Pages 默认连 127.0.0.1:3847）
# VITE_TOKEN_AGENT_URL=http://127.0.0.1:3847

# 知识库 GitHub 仓库（默认 jackielamzeqi/obsidian_vault）
# VITE_GITHUB_KB_OWNER=jackielamzeqi
# VITE_GITHUB_KB_REPO=obsidian_vault
# VITE_GITHUB_KB_BRANCH=main

# ===== Daylog 每日复盘 AI 代理（密钥只在代理侧，禁止进前端） =====
# 本地代理：npm run daylog-proxy（监听 127.0.0.1:8790）
# 后端优先级：codex CLI（ChatGPT）→ kimi CLI（Kimi Code）→ 下方 API key 兜底
# 强制指定后端（可选）：codex | kimi | api
# DAYLOG_AI_BACKEND=codex
# OpenAI 兼容接口密钥（可选；仅当本机没有 codex / kimi CLI 或强制 api 时使用）
DAYLOG_AI_API_KEY=
# 上游接口地址与模型（可选，默认如下）
# DAYLOG_AI_BASE_URL=https://api.moonshot.cn/v1
# DAYLOG_AI_MODEL=moonshot-v1-8k
# 生产环境代理地址（Cloudflare Worker，见 worker/daylog-ai-proxy.js 顶部部署说明）
# 本地开发走 Vite 的 /daylog-ai 代理，可不填
# VITE_DAYLOG_AI_PROXY=
